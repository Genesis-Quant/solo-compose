# 本机现有 PostgreSQL 容器
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_USER=solo
PGSQL_PASSWORD=replace-with-your-solo-password
SOLO_DATABASE=solo
DOLPHINSCHEDULER_DATABASE=solo_ds

# Solo 独立 DolphinScheduler（不占用 Arena 的 12345 / 25333）
DOLPHINSCHEDULER_API_PORT=12346
DOLPHINSCHEDULER_GATEWAY_PORT=25334
DOLPHINSCHEDULER_USERNAME=solo-scheduler
DOLPHINSCHEDULER_PASSWORD=replaceMe12345678
DOLPHINSCHEDULER_PYTHON_GATEWAY_TOKEN=replace-with-a-long-random-token

# 可选：填写已存在的外部 Docker 网络名；未设置或留空则由 Compose 自动创建默认网络
# 使用容器 DNS 连接本地 DolphinDB 时，将其加入所选网络
SOLO_DOCKER_NETWORK=

# stock_basic 股票列表：上市、退市、暂停上市股票，由 Arena Runtime 缓存
TUSHARE_TOKEN=

# Solo 数据查询与因子分析：本地 DolphinDB；填写实际账号和密码
SOLO_DOLPHIN_HOST=dolphindb
SOLO_DOLPHIN_PORT=8848
SOLO_DOLPHIN_USERNAME=
SOLO_DOLPHIN_PASSWORD=

# Backtest 回测：远端 DolphinDB；填写实际账号和密码
BACKTEST_DOLPHIN_HOST=dolphindb
BACKTEST_DOLPHIN_PORT=8848
BACKTEST_DOLPHIN_USERNAME=
BACKTEST_DOLPHIN_PASSWORD=

# Solo 服务端口
BACKEND_BIND_IP=127.0.0.1
BACKEND_BIND_PORT=8010
FRONTEND_BIND_IP=127.0.0.1
FRONTEND_BIND_PORT=5174
SOLO_WEB_ORIGINS=http://127.0.0.1:5174,http://localhost:5174

# Jupyter
JUPYTER_BIND_IP=127.0.0.1
JUPYTER_BIND_PORT=8888
JUPYTER_TOKEN=replace-with-a-long-random-token
JUPYTER_URL=http://127.0.0.1:8888
# 可选，用于提高 Gitee API 访问额度
GITEE_TOKEN=
