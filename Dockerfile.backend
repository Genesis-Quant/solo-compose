FROM python:3.12-slim-bookworm AS uv
ENV PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN python -m pip install --no-cache-dir --no-deps --only-binary=:all: uv==0.11.25

FROM python:3.12-slim-bookworm
RUN sed -i 's|http://deb.debian.org/debian|https://mirrors.tuna.tsinghua.edu.cn/debian|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=uv /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/
ENV PYTHONUNBUFFERED=1 UV_LINK_MODE=hardlink UV_PROJECT_ENVIRONMENT=/app/.venv PATH="/app/.venv/bin:${PATH}" \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple \
    UV_PYTHON_INSTALL_MIRROR=https://registry.npmmirror.com/-/binary/python-build-standalone
WORKDIR /app
COPY backend/pyproject.toml backend/uv.lock ./
RUN UV_CACHE_DIR=/app/.cache/uv uv sync --locked --no-dev --no-install-project && rm -rf /app/.cache/uv
COPY backend/ ./
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn main:app --host 0.0.0.0 --port 8000"]
